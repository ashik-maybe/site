{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "src/styles/global.css",
    "functions": [
      "cn",
      "cva"
    ]
  },
  "astro": {},
  "associations": [
    {
      "files": [
        "*.astro"
      ],
      "language": "astro"
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "coverage/",
    ".pnpm-store/",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock"
  ]
}
