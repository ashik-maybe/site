---
import { Badge } from "@/components/ui/badge"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
import {
  absolute,
  breadcrumbNode,
  graph,
  personNode,
  webSiteNode,
} from "@/lib/seo"
import { readingTime, slugifyTag } from "@/lib/text"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft)
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }))
}

const { post, newer, older } = Astro.props
const { Content, headings } = await render(post)
const base = import.meta.env.BASE_URL

const toc = headings.filter((heading) => heading.depth === 2)
const minutes = readingTime(post.body)
const date = post.data.pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
})

const postUrl = absolute(`/blog/${post.id}/`)
const ogImage = `/og/blog/${post.id}.png`
const words = (post.body ?? "").trim().split(/\s+/).length

const jsonLd = graph(
  personNode(),
  webSiteNode(),
  {
    "@type": "BlogPosting",
    "@id": `${postUrl}#article`,
    headline: post.data.title,
    description: post.data.description,
    url: postUrl,
    mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate
      ? { dateModified: post.data.updatedDate.toISOString() }
      : {}),
    inLanguage: "en",
    ...(post.data.tags.length > 0
      ? { keywords: post.data.tags.join(", ") }
      : {}),
    wordCount: words,
    timeRequired: `PT${minutes}M`,
    image: absolute(ogImage),
    author: { "@id": `${absolute("/")}#person` },
    isPartOf: { "@id": `${absolute("/")}#website` },
  },
  breadcrumbNode([
    { name: "Blog", path: "/blog/" },
    { name: post.data.title, path: `/blog/${post.id}/` },
  ])
)
---

<Layout
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  tags={post.data.tags}
  image={ogImage}
  imageAlt={post.data.title}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="reading-progress" aria-hidden="true"></div>
  <article
    class="mx-auto w-full max-w-3xl px-4 py-16 sm:px-6"
    data-pagefind-body
  >
    <header>
      <h1
        class="text-3xl font-medium tracking-tight text-balance sm:text-4xl"
        data-pagefind-meta="title"
      >
        {post.data.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
        <time datetime={post.data.pubDate.toISOString()}>{date}</time>
        <span class="font-mono">{minutes} min read</span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <a
              href={`${base}/blog/tags/${slugifyTag(tag)}/`}
              aria-label={`More posts tagged ${tag}`}
            >
              <Badge variant="secondary" className="font-normal">
                {tag}
              </Badge>
            </a>
          ))}
        </div>
      )}
    </header>

    {toc.length > 1 && (
      <nav
        aria-label="Table of contents"
        class="mt-10 rounded-lg border border-border/60 bg-card p-4"
      >
        <p class="font-mono text-xs text-muted-foreground">On this page</p>
        <ul class="mt-2 space-y-1 text-sm">
          {toc.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose mt-10 max-w-none prose-neutral dark:prose-invert">
      <Content />
    </div>

    {(newer || older) && (
      <footer class="mt-14 flex items-start justify-between gap-6 border-t border-border/60 pt-6">
        {older ? (
          <a
            href={`${base}/blog/${older.id}/`}
            class="max-w-[45%] text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            <span class="block font-mono text-xs">Older</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a
            href={`${base}/blog/${newer.id}/`}
            class="max-w-[45%] text-right text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            <span class="block font-mono text-xs">Newer</span>
            {newer.data.title}
          </a>
        ) : (
          <span />
        )}
      </footer>
    )}
  </article>
</Layout>
