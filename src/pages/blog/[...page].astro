---
import PostRow from "@/components/blog/PostRow.astro"
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyTitle,
} from "@/components/ui/empty"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"
import type { Page, PaginateFunction } from "astro"

const base = import.meta.env.BASE_URL

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  // Deliberately small so pagination ships exercised in the template; bump
  // the page size once real posts accumulate.
  if (posts.length === 0) {
    // paginate([]) would generate no pages and 404 the index; keep it alive.
    return [{ params: { page: undefined }, props: { page: null } }]
  }
  return paginate(posts, { pageSize: 2 })
}

const { page } = Astro.props as {
  page: Page<CollectionEntry<"blog">> | null
}

// Astro's page.url.prev/next lack the trailing slash this site canonicalises on.
const pagerUrl = (url: string | undefined) =>
  url && !url.endsWith("/") ? `${url}/` : url
---

<Layout
  title={
    page && page.currentPage > 1
      ? `Blog (page ${page.currentPage}) | ${site.name}`
      : `Blog | ${site.name}`
  }
  description="Notes on data structures, Python, machine learning, and the tools I use."
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="font-mono text-2xl font-medium text-balance">Blog</h1>
      <div class="flex items-baseline gap-4">
        <a
          href={`${base}/tags/`}
          class="font-mono text-sm text-muted-foreground transition-colors hover:text-primary"
        >
          Tags
        </a>
        <a
          href={`${base}/blog/rss.xml`}
          class="font-mono text-sm text-muted-foreground transition-colors hover:text-primary"
        >
          RSS
        </a>
        <a
          href={`${base}/blog/feed.json`}
          class="font-mono text-sm text-muted-foreground transition-colors hover:text-primary"
        >
          JSON
        </a>
      </div>
    </div>
    <p class="mt-3 max-w-prose text-muted-foreground">
      Notes on data structures, Python, machine learning, and the tools I use.
    </p>
    {page === null || page.data.length === 0 ? (
      <Empty className="mt-10 border">
        <EmptyHeader>
          <EmptyTitle>No posts yet</EmptyTitle>
          <EmptyDescription>
            Nothing published yet. New notes show up here as soon as I write
            them.
          </EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : (
      <>
        <ul class="mt-10 divide-y divide-border border-t border-border/60">
          {page.data.map((post) => (
            <PostRow post={post} />
          ))}
        </ul>
        {(page.url.prev || page.url.next) && (
          <nav
            aria-label="Pagination"
            class="mt-10 flex items-center justify-between gap-4"
          >
            {page.url.prev ? (
              <a
                href={pagerUrl(page.url.prev)}
                rel="prev"
                class="font-mono text-sm text-muted-foreground transition-colors hover:text-primary"
              >
                ← Newer posts
              </a>
            ) : (
              <span />
            )}
            <span class="font-mono text-xs text-muted-foreground">
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.url.next ? (
              <a
                href={pagerUrl(page.url.next)}
                rel="next"
                class="font-mono text-sm text-muted-foreground transition-colors hover:text-primary"
              >
                Older posts →
              </a>
            ) : (
              <span />
            )}
          </nav>
        )}
      </>
    )}
  </section>
</Layout>
