---
import ProjectCard from "@/components/portfolio/ProjectCard.astro"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
import { slugifyTag } from "@/lib/text"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const projects = await getCollection("projects")
  const byTag = new Map<
    string,
    { label: string; entries: CollectionEntry<"projects">[] }
  >()
  for (const project of projects) {
    for (const tag of project.data.tags) {
      const key = slugifyTag(tag)
      const group = byTag.get(key) ?? { label: tag, entries: [] }
      group.entries.push(project)
      byTag.set(key, group)
    }
  }
  return [...byTag].map(([tag, { label, entries }]) => ({
    params: { tag },
    props: {
      tag: label,
      entries: entries.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      ),
    },
  }))
}

const { tag, entries } = Astro.props
---

<Layout
  title={`Projects tagged “${tag}” | ${site.name}`}
  description={`Every project tagged “${tag}”.`}
  robots="noindex, follow"
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <p class="font-mono text-sm text-muted-foreground">Tag</p>
    <h1 class="mt-1 font-mono text-2xl font-medium text-balance">{tag}</h1>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Layout>
