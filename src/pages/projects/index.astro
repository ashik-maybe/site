---
import ProjectCard from "@/components/portfolio/ProjectCard.astro"
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyTitle,
} from "@/components/ui/empty"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
import { getCollection } from "astro:content"

const base = import.meta.env.BASE_URL
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<Layout
  title={`Projects | ${site.name}`}
  description="Course work, tools, and things I built to learn something. Write-ups live on each project."
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="font-mono text-2xl font-medium text-balance">Projects</h1>
      <a
        href={`${base}/tags/`}
        class="font-mono text-sm text-muted-foreground transition-colors hover:text-primary"
      >
        Tags
      </a>
    </div>
    <p class="mt-3 max-w-prose text-muted-foreground">
      Course work, tools, and things I built to learn something. Write-ups live
      on each project.
    </p>
    {projects.length === 0 ? (
      <Empty className="mt-10 border">
        <EmptyHeader>
          <EmptyTitle>No projects yet</EmptyTitle>
          <EmptyDescription>
            Write-ups show up here as I ship things.
          </EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : (
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    )}
  </section>
</Layout>
