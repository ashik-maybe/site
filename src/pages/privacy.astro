---
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
---

<Layout
  title={`Privacy | ${site.name}`}
  description="This site is built to collect as little about you as possible: no tracking, no forms, no accounts."
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <h1 class="font-mono text-2xl font-medium text-balance">Privacy</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      This site is built to collect as little about you as possible.
    </p>

    <ul class="mt-8 max-w-prose list-disc space-y-4 pl-5 text-muted-foreground">
      <li>
        <strong class="text-foreground">No tracking.</strong> No cookies, no
        analytics, no ads, no tracking pixels.
      </li>
      <li>
        <strong class="text-foreground">Nothing you submit.</strong> There are
        no accounts and no forms. To contact the site owner, you use your own
        email app — anything you write goes there, not here.
      </li>
      <li>
        <strong class="text-foreground">Settings stay on your device.</strong>
        Display preferences you choose (such as the theme and the text size) are
        saved in your browser and are never sent anywhere.
      </li>
      <li>
        <strong class="text-foreground">Links to other sites.</strong> When you
        follow a link to another service, its own privacy policy applies from
        that point on.
      </li>
    </ul>

    <p class="mt-8 max-w-prose text-muted-foreground">
      If this site ever grows features that involve your data — a contact form,
      comments, a newsletter, analytics — this page will be updated to describe
      what is collected and why.
    </p>

    <!-- Template note: this page describes the site as shipped. If you add
         cookies, analytics, forms or comments, update it to match. -->
  </section>
</Layout>
