---
import Layout from "@/layouts/main.astro"
import SearchPanel from "@/components/ui/search-panel.astro"
import { site } from "@/config"

const base = import.meta.env.BASE_URL
---

<Layout
  title={`Search | ${site.name}`}
  description="Full-text search across blog posts."
  robots="noindex, follow"
>
  {/* Pagefind writes these next to the build output, so the bundle path is
      resolved at runtime, not by Vite. */}
  <Fragment slot="head">
    <link rel="preload" as="script" href={`${base}/pagefind/pagefind.js`} />
  </Fragment>

  <SearchPanel />

  {/* Drives Pagefind's JS API directly instead of its web components, so the
      input and results are our own markup (`search-panel.astro`) with no
      `all: initial` reset to fight and no third island. `is:inline` keeps the
      dynamic `import()` out of the bundler — the URL only exists after
      `pagefind --site dist` runs, which is after the Astro build. */}
  <script is:inline>
    const initSearch = () => {
      const panel = document.querySelector("[data-search-panel]")
      if (!panel) return
      const input = panel.querySelector("[data-search-input]")
      const results = panel.querySelector("[data-search-results]")
      const status = panel.querySelector("[data-search-status]")
      const states = panel.querySelectorAll("[data-search-panel-state]")
      if (!input || !results || !status) return
      // `astro:page-load` fires again on every client-side navigation, so guard
      // against wiring the same DOM twice.
      if (panel.dataset.searchReady === "true") return
      panel.dataset.searchReady = "true"

      const showState = (name) => {
        for (const el of states)
          el.hidden = el.dataset.searchPanelState !== name
      }
      for (const el of states)
        if (el.dataset.searchPanelState === "idle") el.hidden = false

      // Read from the element rather than a literal: the base path is a build
      // input, and an `is:inline` body is never interpolated by Astro.
      const base = panel.dataset.searchBase ?? ""
      let pagefind = null
      let failure = null

      // `pagefind.js` is a module, so it is pulled in lazily: a visitor who
      // never types pays nothing for it.
      const ready = import(`${base}/pagefind/pagefind.js`)
        .then(async (mod) => {
          await mod.options({ baseUrl: base })
          await mod.init()
          pagefind = mod
        })
        .catch((error) => {
          // No index (the usual case is `astro dev` before a build): surface it
          // instead of leaving an input that silently does nothing.
          failure = error
          input.disabled = true
          showState("unavailable")
        })

      let token = 0
      const run = async (query) => {
        const term = query.trim()
        await ready
        const mine = ++token
        // A later keystroke already superseded this run; drop the result.
        if (mine !== token) return
        if (failure) {
          status.textContent = ""
          results.hidden = true
          results.replaceChildren()
          showState("unavailable")
          return
        }
        if (term === "") {
          status.textContent = ""
          results.hidden = true
          results.replaceChildren()
          showState("idle")
          return
        }

        const search = await pagefind.search(term)
        if (mine !== token) return

        const rows = await Promise.all(
          search.results.slice(0, 10).map((r) => r.data())
        )

        status.textContent =
          search.results.length === 0
            ? ""
            : `${search.results.length} result${search.results.length === 1 ? "" : "s"} for “${term}”`

        results.replaceChildren(...rows.map((row) => renderRow(row)))
        results.hidden = rows.length === 0
        showState(rows.length === 0 ? "empty" : "none")
      }

      /**
       * One result row. `excerpt` already carries Pagefind's highlight markup,
       * so it is the only value inserted as HTML — every other field is text.
       */
      const renderRow = (row) => {
        const item = document.createElement("li")
        item.className =
          "border-t border-border py-5 first:border-t-0 first:pt-0"

        const link = document.createElement("a")
        link.href = row.meta?.url || row.url
        link.textContent = row.meta?.title || "Untitled"
        link.className =
          "text-base font-medium text-balance transition-colors hover:text-primary"

        const excerpt = document.createElement("p")
        excerpt.className =
          "mt-1.5 text-sm leading-relaxed text-muted-foreground"
        excerpt.innerHTML = row.excerpt || ""

        // `excerpt` is Pagefind's own highlight markup; the title is text.
        item.append(link, excerpt)
        return item
      }

      let timer = 0
      input.addEventListener("input", () => {
        clearTimeout(timer)
        const value = input.value
        timer = setTimeout(() => run(value), 150)
      })
      // `type="search"` renders a clear button in some browsers; Enter should
      // search immediately rather than wait out the debounce.
      input.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          clearTimeout(timer)
          run(input.value)
        }
      })
    }

    initSearch()
    // This inline script re-executes on every client-side navigation, so the
    // listener is registered once per page load rather than once per navigation.
    if (!window.__searchSync) {
      window.__searchSync = true
      document.addEventListener("astro:page-load", initSearch)
    }
  </script>
</Layout>
