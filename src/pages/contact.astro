---
import SocialLinks from "@/components/layout/SocialLinks.astro"
import { buttonVariants } from "@/components/ui/button"
import { ButtonGroup } from "@/components/ui/button-group"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
import { emailHref } from "@/lib/socials"
import { MailIcon } from "lucide-react"
---

<Layout
  title={`Contact | ${site.name}`}
  description="The fastest way to reach me is email. I answer questions about the projects here, collaborations, and internships."
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <h1 class="font-mono text-2xl font-medium text-balance">Contact</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      The fastest way to reach me is email. I answer questions about the
      projects here, collaborations, and internships.
    </p>

    <ButtonGroup className="mt-8">
      <a href={emailHref} data-slot="button" class={buttonVariants()}>
        <MailIcon aria-hidden="true" />
        Email me
      </a>
    </ButtonGroup>

    <h2 class="mt-14 text-lg font-medium">Elsewhere</h2>
    <SocialLinks variant="cards" class="mt-4" />
  </section>
</Layout>
