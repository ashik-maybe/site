---
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
import { cn } from "cn"

const base = import.meta.env.BASE_URL
---

<Layout title={`Page not found | ${site.name}`} robots="noindex, follow">
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-1 font-mono text-2xl font-medium text-balance">
      This page doesn't exist
    </h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      The link may be outdated or mistyped. Try the nav bar above, or pick a
      popular page:
    </p>
    <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
      <li>
        <a
          href={`${base}/about`}
          class="font-medium text-primary underline-offset-4 hover:underline"
        >
          About
        </a>
      </li>
      <li>
        <a
          href={`${base}/projects`}
          class="font-medium text-primary underline-offset-4 hover:underline"
        >
          Projects
        </a>
      </li>
      <li>
        <a
          href={`${base}/blog`}
          class="font-medium text-primary underline-offset-4 hover:underline"
        >
          Blog
        </a>
      </li>
      <li>
        <a
          href={`${base}/contact`}
          class="font-medium text-primary underline-offset-4 hover:underline"
        >
          Contact
        </a>
      </li>
    </ul>
    <a
      href={`${base}/`}
      data-slot="button"
      class={cn(buttonVariants(), "mt-8")}
    >
      Go to the home page
    </a>
  </section>
</Layout>
