---
import Layout from "@/layouts/main.astro"
import { site } from "@/config"

const base = import.meta.env.BASE_URL
---

<Layout title={`Page not found | ${site.name}`} robots="noindex, follow">
  <section class="mx-auto w-full max-w-5xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-2 text-2xl font-medium text-balance">
      This page doesn't exist
    </h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      The link may be outdated or mistyped. Try the nav bar above, or pick a
      popular page:
    </p>
    <ul class="mt-6 flex flex-wrap gap-3">
      <li>
        <a
          href={`${base}/about`}
          class="text-primary underline hover:text-primary/80"
        >
          About
        </a>
      </li>
      <li>
        <a
          href={`${base}/projects`}
          class="text-primary underline hover:text-primary/80"
        >
          Projects
        </a>
      </li>
      <li>
        <a
          href={`${base}/blog`}
          class="text-primary underline hover:text-primary/80"
        >
          Blog
        </a>
      </li>
      <li>
        <a
          href={`${base}/contact`}
          class="text-primary underline hover:text-primary/80"
        >
          Contact
        </a>
      </li>
    </ul>
    <a
      href={`${base}/`}
      class="mt-6 inline-block rounded-md px-2.5 py-2 text-sm font-medium text-primary underline-offset-4 hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
    >
      Go to the home page
    </a>
  </section>
</Layout>
