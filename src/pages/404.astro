---
import Layout from "@/layouts/main.astro"

const base = import.meta.env.BASE_URL
---

<Layout title="Page not found | Ashik's Website">
  <section class="mx-auto w-full max-w-5xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-2 text-2xl font-medium">This page doesn't exist</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      The link may be outdated or mistyped. The nav bar still works.
    </p>
    <a
      href={`${base}/`}
      class="mt-6 inline-block rounded-md px-2.5 py-2 text-sm font-medium text-primary underline-offset-4 hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
    >
      Go to the home page
    </a>
  </section>
</Layout>
