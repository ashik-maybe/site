---
import { ProfileAvatar } from "@/components/portfolio/ProfileAvatar"
import { Badge } from "@/components/ui/badge"
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { Separator } from "@/components/ui/separator"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"

const skills: { group: string; items: string[] }[] = [
  { group: "Languages", items: ["Python", "C/C++", "JavaScript", "TypeScript", "SQL"] },
  { group: "Web", items: ["Astro", "React", "Tailwind CSS", "HTML/CSS"] },
  { group: "Tools", items: ["Git", "Linux", "Bash", "Docker", "NumPy", "PyTorch"] },
]

// TODO: replace with real education, experience, and interests.
const timeline = [
  {
    role: "Software Engineering Intern",
    org: "Placeholder Company",
    period: "Summer 2026",
    detail: "One line about what you shipped and what it changed.",
  },
  {
    role: "Teaching Assistant, Data Structures",
    org: "Placeholder University",
    period: "2025 – 2026",
    detail: "One line about lab sections, grading, or office hours.",
  },
]
---

<Layout
  title={`About | ${site.name}`}
  description="Background, education, skills, and experience."
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <div class="flex items-center gap-4">
      <ProfileAvatar initial="A" />
      <div>
        <h1 class="font-mono text-balance text-2xl font-medium">{site.name}</h1>
        <p class="mt-1 text-muted-foreground">CSE undergrad, SWE/AI focus</p>
      </div>
    </div>

    <p class="mt-8 max-w-prose text-muted-foreground">
      I study computer science and build things in software and AI. This site
      collects what I learn — data structures, Python, machine learning — and the
      projects I ship along the way. Write here replaces notes I would otherwise
      keep in a private folder.
    </p>

    <h2 class="mt-14 text-lg font-medium">Education</h2>
    <Card className="mt-4">
      <CardHeader>
        <CardTitle className="text-base">
          B.E. in Computer Science and Engineering
        </CardTitle>
        <CardDescription>
          Placeholder University, expected 2028
        </CardDescription>
      </CardHeader>
    </Card>

    <h2 class="mt-14 text-lg font-medium">Skills</h2>
    <dl class="mt-4 space-y-4">
      {
        skills.map(({ group, items }) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-6">
            <dt class="w-24 shrink-0 font-mono text-sm text-muted-foreground">
              {group}
            </dt>
            <dd class="flex flex-wrap gap-1.5">
              {items.map((item) => (
                <Badge variant="secondary" className="font-normal">
                  {item}
                </Badge>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>

    <h2 class="mt-14 text-lg font-medium">Experience</h2>
    <div class="mt-4 space-y-0">
      {
        timeline.map((entry, index) => (
          <>
            {index > 0 && <Separator className="my-4" />}
            <div class="grid gap-x-8 gap-y-1 sm:grid-cols-[10rem_1fr]">
              <span class="font-mono text-sm text-muted-foreground">
                {entry.period}
              </span>
              <div>
                <p class="font-medium">{entry.role}</p>
                <p class="text-muted-foreground">{entry.org}</p>
                <p class="mt-1 max-w-prose text-sm text-muted-foreground">
                  {entry.detail}
                </p>
              </div>
            </div>
          </>
        ))
      }
    </div>

    <h2 class="mt-14 text-lg font-medium">Interests</h2>
    <p class="mt-3 max-w-prose text-muted-foreground">
      Competitive programming, terminal tooling, machine learning papers,
      chess.
    </p>
  </section>
</Layout>
