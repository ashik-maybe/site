---
import ProfileAvatar from "@/components/portfolio/ProfileAvatar.astro"
import Skills from "@/components/portfolio/Skills.astro"
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { Separator } from "@/components/ui/separator"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"

const raw: { group: string; items: string[] }[] = [
  {
    group: "Languages",
    items: ["Python", "JavaScript", "TypeScript", "Java", "C++", "C"],
  },
  {
    group: "Frontend",
    items: ["React", "Next.js", "HTML", "CSS", "Tailwind CSS", "Astro"],
  },
  { group: "Backend", items: ["FastAPI", "Hono", "MySQL"] },
  {
    group: "Tools",
    items: [
      "Git",
      "Github",
      "Linux",
      "Fedora Linux",
      "fish shell",
      "Bash",
      "Podman",
      "Docker",
    ],
  },
  { group: "Libraries", items: ["NumPy", "Scikit-learn", "PyTorch"] },
]

// Arrays read top to bottom: move an entry to change its prominence. No sort,
// so placement is editorial and deliberate.
const skills = raw

// TODO: replace with real education, experience, and interests.
// Everything below is deliberately obvious placeholder text (not real history).
const timeline = [
  {
    role: "Example Role (replace me)",
    org: "Example Company (placeholder)",
    period: "TODO — your dates",
    detail: "One line about what you shipped and what it changed.",
  },
  {
    role: "Example Role (replace me)",
    org: "Example University (placeholder)",
    period: "TODO — your dates",
    detail: "One line about lab sections, grading, or office hours.",
  },
]
---

<Layout
  title={`About | ${site.name}`}
  description="Background, education, skills, and experience."
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <div class="flex items-center gap-4">
      <ProfileAvatar initial="J" />
      <div>
        <h1 class="font-mono text-2xl font-medium text-balance">{site.name}</h1>
        <p class="mt-1 text-muted-foreground">CSE undergrad, SWE/AI focus</p>
      </div>
    </div>

    <p class="mt-8 max-w-prose text-muted-foreground">
      My name is John Doe. I study computer science and build things in software
      and AI. This site collects what I learn — data structures, Python, machine
      learning — and the projects I ship along the way. Writing here replaces
      notes I would otherwise keep in a private folder.
    </p>

    <h2 class="mt-14 text-lg font-medium">Education</h2>
    <Card className="mt-4">
      <CardHeader>
        <CardTitle>Degree (replace me)</CardTitle>
        <CardDescription>
          Example University (placeholder), TODO — expected year
        </CardDescription>
      </CardHeader>
    </Card>

    <h2 class="mt-14 text-lg font-medium">Skills</h2>
    <Skills groups={skills} class="mt-4" />

    <h2 class="mt-14 text-lg font-medium">Experience</h2>
    <div class="mt-4 space-y-0">
      {timeline.map((entry, index) => (
        <>
          {index > 0 && <Separator className="my-4" />}
          <div class="grid gap-x-8 gap-y-1 sm:grid-cols-[10rem_1fr]">
            <span class="font-mono text-sm text-muted-foreground">
              {entry.period}
            </span>
            <div>
              <p class="font-medium">{entry.role}</p>
              <p class="text-muted-foreground">{entry.org}</p>
              <p class="mt-1 max-w-prose text-sm text-muted-foreground">
                {entry.detail}
              </p>
            </div>
          </div>
        </>
      ))}
    </div>

    <h2 class="mt-14 text-lg font-medium">Interests</h2>
    <p class="mt-3 max-w-prose text-muted-foreground">
      Competitive programming, terminal tooling, machine learning papers, chess.
    </p>
  </section>
</Layout>
