---
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
import { buttonVariants } from "@/components/ui/button"
import { ButtonGroup } from "@/components/ui/button-group"
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import ProjectCard from "@/components/portfolio/ProjectCard.astro"
import PostRow from "@/components/blog/PostRow.astro"
import { getCollection } from "astro:content"

const base = import.meta.env.BASE_URL
const featured = await getCollection("projects", ({ data }) => data.featured)
featured.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const projects = featured.slice(0, 3)

const latest = await getCollection("blog", ({ data }) => !data.draft)
latest.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const posts = latest.slice(0, 3)

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.site,
  sameAs: site.socials
    .filter((social) => social.href.startsWith("https"))
    .map((social) => social.href),
}
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="space-y-24 pb-24">
    <section class="mx-auto w-full max-w-5xl px-4 pt-20 sm:px-6">
      <h1 class="max-w-3xl text-balance text-4xl font-medium tracking-tight sm:text-5xl">
        I'm Ashik. I study computer science and build things in software and
        AI.
      </h1>
      <p class="mt-5 max-w-prose text-lg text-muted-foreground">
        This is where I write up what I learn and collect the projects I've
        shipped.
      </p>
      <ButtonGroup className="mt-8">
        <a href={`${base}/projects/`} data-slot="button" class={buttonVariants()}>
          View projects
        </a>
        <a
          href={`${base}/blog/`}
          data-slot="button"
          class={buttonVariants({ variant: "outline" })}
        >
          Read blog
        </a>
      </ButtonGroup>
    </section>

    <section class="mx-auto w-full max-w-5xl px-4 sm:px-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-lg font-medium">Selected projects</h2>
        <a
          href={`${base}/projects/`}
          class="font-mono text-sm text-muted-foreground transition-colors hover:text-primary"
        >
          All projects
        </a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="mx-auto w-full max-w-5xl px-4 sm:px-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-lg font-medium">Latest posts</h2>
        <a
          href={`${base}/blog/`}
          class="font-mono text-sm text-muted-foreground transition-colors hover:text-primary"
        >
          All posts
        </a>
      </div>
      <ul class="mt-4 divide-y divide-border border-t border-border/60">
        {posts.map((post) => <PostRow post={post} />)}
      </ul>
    </section>

    <section class="mx-auto w-full max-w-5xl px-4 sm:px-6">
      <h2 class="text-lg font-medium">About</h2>
      <p class="mt-3 max-w-prose text-muted-foreground">
        CSE undergrad with a focus on software engineering and AI. I write about
        data structures, Python, and machine learning, and I build small tools
        when a note turns into an idea.
      </p>
      <a
        href={`${base}/about/`}
        class="mt-3 inline-block text-sm font-medium text-primary underline-offset-4 hover:underline"
      >
        More about me
      </a>
    </section>

    <section class="mx-auto w-full max-w-5xl px-4 sm:px-6">
      <Card>
        <CardHeader>
          <CardTitle className="text-lg">Working on something together?</CardTitle>
          <CardDescription className="max-w-prose">
            Internships, open source, side projects, or questions about
            anything here — email reaches me fastest.
          </CardDescription>
          <CardFooter className="mt-2 pl-0">
            <a
              href="mailto:hello@example.com"
              data-slot="button"
              class={buttonVariants()}
            >
              Email me
            </a>
          </CardFooter>
        </CardHeader>
      </Card>
    </section>
  </div>
</Layout>
