---
import { Badge } from "@/components/ui/badge"
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyTitle,
} from "@/components/ui/empty"
import Layout from "@/layouts/main.astro"
import { site } from "@/config"
import { slugifyTag } from "@/lib/text"
import { getCollection } from "astro:content"

const base = import.meta.env.BASE_URL

const posts = await getCollection("blog", ({ data }) => !data.draft)
const projects = await getCollection("projects")

/** Tag labels with usage counts, keyed by slug, alphabetical. */
function tagCounts(entries: { data: { tags: string[] } }[]) {
  const bySlug = new Map<string, { label: string; count: number }>()
  for (const entry of entries) {
    for (const tag of entry.data.tags) {
      const slug = slugifyTag(tag)
      const group = bySlug.get(slug) ?? { label: tag, count: 0 }
      group.count += 1
      bySlug.set(slug, group)
    }
  }
  return [...bySlug.values()].sort((a, b) =>
    a.label.localeCompare(b.label, "en")
  )
}

const blogTags = tagCounts(posts)
const projectTags = tagCounts(projects)
---

<Layout
  title={`Tags | ${site.name}`}
  description="Every tag across the blog and projects."
  robots="noindex, follow"
>
  <section class="mx-auto w-full max-w-5xl px-4 py-16 sm:px-6">
    <h1 class="font-mono text-2xl font-medium text-balance">Tags</h1>
    <p class="mt-3 max-w-prose text-muted-foreground">
      Every tag across the blog and projects.
    </p>
    {blogTags.length + projectTags.length === 0 ? (
      <Empty className="mt-10 border">
        <EmptyHeader>
          <EmptyTitle>No tags yet</EmptyTitle>
          <EmptyDescription>
            Tags show up here as posts and projects get published.
          </EmptyDescription>
        </EmptyHeader>
      </Empty>
    ) : (
      <>
        {blogTags.length > 0 && (
          <>
            <h2 class="mt-14 text-lg font-medium">Blog</h2>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {blogTags.map(({ label, count }) => (
                <li>
                  <a
                    href={`${base}/blog/tags/${slugifyTag(label)}/`}
                    class="group"
                  >
                    <Badge
                      variant="secondary"
                      className="font-normal group-hover:text-primary focus-visible:text-primary"
                    >
                      {label} ({count})
                    </Badge>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        {projectTags.length > 0 && (
          <>
            <h2 class="mt-14 text-lg font-medium">Projects</h2>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {projectTags.map(({ label, count }) => (
                <li>
                  <a
                    href={`${base}/projects/tags/${slugifyTag(label)}/`}
                    class="group"
                  >
                    <Badge
                      variant="secondary"
                      className="font-normal group-hover:text-primary focus-visible:text-primary"
                    >
                      {label} ({count})
                    </Badge>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )}
  </section>
</Layout>
