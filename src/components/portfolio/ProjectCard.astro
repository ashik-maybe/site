---
import { Badge } from "@/components/ui/badge"
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { slugifyTag } from "@/lib/text"
import type { CollectionEntry } from "astro:content"

interface Props {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
const base = import.meta.env.BASE_URL
---

<Card className="flex h-full flex-col">
  <CardHeader>
    <CardTitle>
      <a
        href={`${base}/projects/${project.id}/`}
        class="transition-colors hover:text-primary"
      >
        {project.data.title}
      </a>
    </CardTitle>
    <CardDescription>{project.data.description}</CardDescription>
  </CardHeader>
  <CardFooter className="mt-auto flex flex-wrap items-center gap-1.5">
    {project.data.tags.map((tag) => (
      <a
        href={`${base}/projects/tags/${slugifyTag(tag)}/`}
        aria-label={`More projects tagged ${tag}`}
        class="group"
      >
        <Badge
          variant="secondary"
          className="font-normal group-hover:text-primary focus-visible:text-primary"
        >
          {tag}
        </Badge>
      </a>
    ))}
  </CardFooter>
</Card>
