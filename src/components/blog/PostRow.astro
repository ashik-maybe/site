---
import { Badge } from "@/components/ui/badge"
import { slugifyTag } from "@/lib/text"
import type { CollectionEntry } from "astro:content"

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const base = import.meta.env.BASE_URL
const date = post.data.pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
})
---

<li class="grid gap-x-8 gap-y-2 py-6 sm:grid-cols-[7rem_1fr]">
  <time
    class="font-mono text-sm text-muted-foreground"
    datetime={post.data.pubDate.toISOString()}
  >
    {date}
  </time>
  <div>
    <a
      href={`${base}/blog/${post.id}/`}
      class="text-base font-medium transition-colors hover:text-primary"
    >
      {post.data.title}
    </a>
    <p class="mt-1 max-w-prose text-sm text-muted-foreground">
      {post.data.description}
    </p>
    {
      post.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <a
              href={`${base}/blog/tags/${slugifyTag(tag)}/`}
              aria-label={`More posts tagged ${tag}`}
              class="group"
            >
              <Badge
                variant="secondary"
                className="font-normal group-hover:text-primary"
              >
                {tag}
              </Badge>
            </a>
          ))}
        </div>
      )
    }
  </div>
</li>
