---
import MobileNav from "@/components/layout/MobileNav"
import TextSizeToggle from "@/components/layout/TextSizeToggle"
import ThemeToggle from "@/components/layout/ThemeToggle"
import { site } from "@/config"

const base = import.meta.env.BASE_URL

// Astro.url.pathname may or may not carry the base depending on the build
// target, so normalize both cases down to a bare route path.
const withoutBase = Astro.url.pathname.replace(base, "") || "/"
const current =
  withoutBase.length > 1 ? withoutBase.replace(/\/$/, "") : withoutBase

const hrefFor = (href: string) => (href === "/" ? `${base}/` : `${base}${href}`)
const isActive = (href: string) =>
  current === href || current.startsWith(`${href}/`)
---

<header class="site-header sticky top-0 z-40 border-b border-border/60 bg-background/70 backdrop-blur-xl backdrop-saturate-150">
  <div class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between gap-2 px-4 sm:px-6">
    <a
      href={`${base}/`}
      class="-ml-1 rounded-md px-1 py-2 font-mono text-sm font-medium whitespace-nowrap transition-colors hover:text-primary focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
      aria-current={current === "/" ? "page" : undefined}
    >
      {site.name}
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-0.5">
        {site.nav.map((item) => {
          const active = isActive(item.href)
          return (
            <li>
              <a
                href={hrefFor(item.href)}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "relative block rounded-md px-2.5 py-2 text-sm transition-colors hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none active:bg-muted",
                  active
                    ? "font-medium text-foreground after:absolute after:inset-x-2.5 after:bottom-0.5 after:h-0.5 after:rounded-full after:bg-primary"
                    : "text-muted-foreground",
                ]}
              >
                {item.label}
              </a>
            </li>
          )
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {/* Persisted so the island keeps its hydration/state across swaps;
          MobileNav stays unpersisted — its `current` prop is per-page. */}
      <ThemeToggle
        client:idle
        transition:persist="theme-toggle"
        className="size-9"
      />
      <TextSizeToggle
        client:idle
        transition:persist="text-size-toggle"
        className="size-9"
      />
      {/* `md:hidden` above means this island is only ever visible below 768px,
          so skip desktop hydration entirely. */}
      <MobileNav
        client:media="(max-width: 767px)"
        current={current}
        className="size-9 md:hidden"
      />
    </div>
  </div>
</header>
