---
import "@/styles/global.css"
import interWoff2 from "@/assets/fonts/inter-latin-wght-normal.woff2?url"
import jetWoff2 from "@/assets/fonts/jetbrains-mono-latin-wght-normal.woff2?url"

import { ClientRouter } from "astro:transitions"
import Header from "@/components/layout/Header.astro"
import Footer from "@/components/layout/Footer.astro"
import { site } from "@/config"
import { absolute } from "@/lib/seo"

interface Props {
  /** Browser tab title. Defaults to the site's home title. */
  title?: string
  /** Meta description. Defaults to the site description. */
  description?: string
  /** Open Graph object type. */
  type?: "website" | "article"
  /** Robots directive, for pages that should stay out of the index. */
  robots?: string
  /** Publication and edit times, for `article` pages. */
  publishedTime?: string
  modifiedTime?: string
  /** Post tags, emitted as `article:tag`, for `article` pages. */
  tags?: string[]
  /** Site-relative path to the Open Graph image. */
  image?: string
  /** Alt text for the Open Graph image. */
  imageAlt?: string
}

const {
  title = site.title,
  description = site.description,
  type = "website",
  robots,
  publishedTime,
  modifiedTime,
  tags,
  image = "/og.png",
  imageAlt,
} = Astro.props
const base = import.meta.env.BASE_URL
const ogImage = absolute(image)
const ogImageAlt = imageAlt ?? `${site.name} — portfolio, projects, and notes`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={Astro.url.href} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Blog · ${site.name}`}
      href={absolute("/blog/rss.xml")}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={`Blog · ${site.name}`}
      href={absolute("/blog/feed.json")}
    />

    <link
      rel="preload"
      as="font"
      href={interWoff2}
      type="font/woff2-variations"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      href={jetWoff2}
      type="font/woff2-variations"
      crossorigin
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta
      name="theme-color"
      content="#eff1f5"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#24273a"
      media="(prefers-color-scheme: dark)"
    />

    <script is:inline>
      // Applied before first paint so the stored theme never flashes.
      // Re-applied on astro:after-swap: a view-transition swap replaces the
      // <html> attributes and the head's theme-color metas with the freshly
      // fetched page's (unthemed) ones, so both must be restored from storage.
      ;(function () {
        // Inline scripts can re-execute across client navigations; wire once.
        if (window.__themeSync) return
        window.__themeSync = true
        try {
          // Always re-queries: references taken before a swap point at nodes
          // that the swap has removed.
          var applyThemeColor = function (isDark) {
            var color = isDark ? "#24273a" : "#eff1f5"
            // Not by media attribute: the first write clears it, so a media
            // selector would never match again after the initial call.
            var metas = document.querySelectorAll('meta[name="theme-color"]')
            for (var i = 0; i < metas.length; i++) {
              metas[i].media = ""
              metas[i].content = color
            }
          }
          var applyTheme = function () {
            var stored = localStorage.getItem("theme") || "system"
            var dark =
              stored === "system"
                ? window.matchMedia("(prefers-color-scheme: dark)").matches
                : stored === "dark"
            var root = document.documentElement
            root.classList.toggle("dark", dark)
            root.style.colorScheme = dark ? "dark" : "light"
            // Sync the browser chrome to the resolved theme, not the OS
            // preference — otherwise a manual toggle leaves the address bar
            // showing the wrong color.
            applyThemeColor(dark)
          }
          applyTheme()
          document.addEventListener("astro:after-swap", applyTheme)

          // Applied before first paint for the same reason as the theme: a
          // reader who picked a larger size must not see default text flash
          // and reflow on every load. <html> survives a swap, so the inline
          // style persists and only the initial call and the swap re-apply
          // it. Percentages, so it composes with the browser's own zoom.
          var applyTextSize = function () {
            var stored = localStorage.getItem("text-size")
            var size =
              stored === "large"
                ? "112.5%"
                : stored === "xlarge"
                  ? "125%"
                  : "100%"
            document.documentElement.style.fontSize = size
          }
          applyTextSize()
          document.addEventListener("astro:after-swap", applyTextSize)

          // Mobile nav: "left" is an opt-in accessibility affordance, so the
          // default (no attribute) is the untouched header. Only a stored
          // "left" sets it, and setting it before paint is what keeps the
          // trigger from flashing across the header on a returning visit.
          // <html> survives a swap, so the swap re-apply covers navigations.
          var applyNavSide = function () {
            var root = document.documentElement
            if (localStorage.getItem("nav-side") === "left") {
              root.dataset.navSide = "left"
            } else {
              delete root.dataset.navSide
            }
          }
          applyNavSide()
          document.addEventListener("astro:after-swap", applyNavSide)

          // The <html> element persists across swaps, so one observer is
          // enough: it follows class changes (e.g. ThemeToggle) and only
          // writes metas — never the class — so it cannot loop.
          new MutationObserver(function () {
            applyThemeColor(document.documentElement.classList.contains("dark"))
          }).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
          })
        } catch (error) {
          // Storage can be unavailable; the light theme is a safe default.
        }
      })()
    </script>
    {/* Per-page head extras (e.g. the search page's Pagefind assets). */}
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-4 focus:z-50 focus:rounded-md focus:border focus:border-border focus:bg-background focus:px-3 focus:py-2 focus:text-sm focus:ring-3 focus:ring-ring/50 focus:outline-none"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
